gdl_version = "1.0"

# Every GDL field: https://github.com/constructorfabric/gearbox/blob/main/docs/gdl.md
#
# Gearbox product metadata for the resource-group gear.
#
# Projected from #[toolkit::gear]: id, runtime_caps (db, rest).

AUTHZ_SDK = cargo(crate_name = "cf-gears-authz-resolver-sdk", lib = "authz_resolver_sdk", path = "../../authz-resolver/authz-resolver-sdk", features = ["rest-client"])
TR_SDK = cargo(crate_name = "cf-gears-types-registry-sdk", lib = "types_registry_sdk", path = "../../types-registry/types-registry-sdk", features = ["rest-client"])

gear(
    deps = [],
    # The authorization resolver and the types registry's tenant API (the only
    # catalogue of RG type definitions) are consumed, not linked: local when
    # co-located, REST otherwise.
    consumes = [
        consume(contract = "AuthZResolverApi", rust = "authz_resolver_sdk::AuthZResolverApi", sdk = AUTHZ_SDK),
        consume(contract = "TypesRegistryApi", rust = "types_registry_sdk::TypesRegistryApi", sdk = TR_SDK),
    ],
    source = git(url = "https://github.com/constructorfabric/gears-rust", path = "gears/system/resource-group/resource-group"),
    maturity = "preview",
    implementation = "in-progress",
    name = "Resource Groups Manager",
    description = "Group related resources into lifecycle-linked collections for bulk access and operations.",
    category = "core-functionality",
    visibility = "internal",

    package = cargo(
        crate_name = "cf-gears-resource-group",
        lib = "resource_group",
        path = ".",
    ),

    # `cf-gears-resource-group-sdk` names its library target
    # `cf_gears_resource_group_sdk` in `[lib]`, NOT `resource_group_sdk`.
    # Declared rather than derived for exactly this reason: deriving it would
    # emit a link line that does not compile.
    sdk = cargo(
        crate_name = "cf-gears-resource-group-sdk",
        lib = "cf_gears_resource_group_sdk",
        path = "../resource-group-sdk",
    ),

    config_schema = config(exposes = ["tenant_type_paths"]),

    # `odata` is a real product decision and is on by Cargo's default; `default`
    # itself is not a choice an integrator makes, and `integration` gates a
    # Postgres suite that needs Docker.
    cargo_features = [feature("odata")],
)
